# Copy to .env and fill in real values. .env is gitignored — never commit
# real keys.

# Get a key at https://dashboard.voyageai.com (API Keys section).
VOYAGE_API_KEY=

# Get a key at https://console.anthropic.com (API Keys section).
# Not needed until Stage 4 (agent loop).
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call the API (CORS). Defaults
# to http://localhost:5173 (Vite's dev port) if unset — only needs setting
# explicitly for a deployed frontend, e.g.:
# FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_ORIGIN=
